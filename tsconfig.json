{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022", "DOM"], "module": "ESNext",
    "moduleResolution": "Bundler", "strict": true, "skipLibCheck": true,
    "noUncheckedIndexedAccess": true, "noFallthroughCasesInSwitch": true,
    "noEmit": true, "resolveJsonModule": true, "isolatedModules": true,
    "types": ["vite/client"]
  },
  "include": ["src/**/*.ts"]
}
