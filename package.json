{
  "name": "project-ironfront",
  "version": "0.19.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "test:logic": "tsc -p tsconfig.logic.json && node scripts/verify-core.cjs",
    "test:browser": "playwright test",
    "check": "npm run typecheck && npm run test && npm run test:logic && npm run test:lan && npm run build",
    "check:full": "npm run check && npm run test:browser",
    "compile:logic": "tsc -p tsconfig.logic.json && node scripts/prepare-logic.cjs",
    "lan": "npm run compile:logic && npm run build && node server/lan.cjs",
    "lan:serve": "node server/lan.cjs",
    "test:lan": "npm run compile:logic && node scripts/test-lan.cjs"
  },
  "dependencies": {
    "three": "^0.180.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/three": "^0.180.0",
    "typescript": "^5.8.3",
    "vite": "^7.1.0",
    "vitest": "^4.1.11"
  }
}
