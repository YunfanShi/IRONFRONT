.screen { position: absolute; left: 0; top: 0; right: 0; bottom: 0; background-color: rgb(18, 19, 18); color: rgb(230, 227, 217); }
.hangar-image, .operator-image, .scene-veil { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.scene-vignette { position: absolute; left: 0; bottom: 0; right: 0; height: 90px; background-color: rgba(7, 9, 9, .15); }
.hidden { display: none; }
.top-bar { position: absolute; left: 0; top: 0; right: 0; height: 48px; background-color: rgba(8, 10, 11, .72); border-bottom-width: 1px; border-bottom-color: rgba(207, 205, 192, .20); }
.brand { position: absolute; left: 30px; top: 11px; flex-direction: row; align-items: center; }
.brand-title { margin: 0; padding: 0; font-size: 23px; -unity-font-style: bold; letter-spacing: 1px; color: rgb(235, 230, 214); }
.version { margin-left: 8px; font-size: 9px; color: rgb(153, 152, 146); }
.navigation { position: absolute; left: 26%; top: 0; width: 270px; height: 48px; flex-direction: row; }
.nav-button { width: 90px; height: 48px; margin: 0; padding: 0; background-color: transparent; border-width: 0; border-bottom-width: 2px; border-bottom-color: transparent; color: rgb(196, 195, 188); font-size: 15px; }
.nav-button:hover { color: rgb(244, 206, 135); background-color: rgba(232, 182, 95, .06); }
.nav-button.active { color: rgb(232, 182, 95); border-bottom-color: rgb(232, 182, 95); -unity-font-style: bold; }
.settings-button { position: absolute; right: 24px; top: 13px; width: 94px; height: 34px; margin: 0; padding: 0; background-color: rgba(12, 14, 15, .36); border-width: 1px; border-color: rgba(206, 207, 198, .38); color: rgb(216, 214, 205); font-size: 13px; }
.settings-button:hover, .settings-button.active { color: rgb(232, 182, 95); border-color: rgb(232, 182, 95); }
.page { position: absolute; left: 24px; top: 82px; bottom: 112px; }
.lobby-page { width: 236px; }
.eyebrow { margin: 0; padding: 0; font-size: 10px; color: rgb(193, 188, 172); letter-spacing: 1px; }
.hero-title { margin: 8px 0 18px 0; padding: 0; font-size: 30px; -unity-font-style: bold; }
.operation-summary { padding: 12px 14px; background-color: rgba(8, 11, 12, .55); border-left-width: 2px; border-left-color: rgb(232, 182, 95); }
.field-label { margin: 0 0 6px 0; padding: 0; font-size: 11px; color: rgb(193, 191, 180); }
.operation-title { margin: 1px 0 5px 0; padding: 0; font-size: 21px; -unity-font-style: bold; }
.body-text { margin: 0; padding: 0; font-size: 11px; color: rgb(184, 184, 176); }
.text-action { height: 27px; margin: 9px 0 0 0; padding: 0; background-color: transparent; border-width: 0; color: rgb(232, 182, 95); font-size: 12px; -unity-text-align: middle-left; }
.text-action:hover { color: rgb(255, 218, 145); }
.lobby-note { display: none; margin: 9px 0 0 0; padding: 0; color: rgb(189, 187, 177); font-size: 10px; -unity-text-align: middle-left; }
.identity-card { position: absolute; left: 24px; bottom: 22px; width: 246px; height: 65px; flex-direction: row; background-color: rgba(6, 9, 10, .67); border-left-width: 2px; border-left-color: rgb(232, 182, 95); }
.identity-badge { width: 53px; margin: 8px; background-color: rgba(124, 135, 120, .23); border-width: 1px; border-color: rgba(176, 182, 163, .28); justify-content: center; align-items: center; }
.identity-mark { font-size: 18px; color: rgb(232, 182, 95); -unity-font-style: bold; }
.name-area { flex-grow: 1; margin: 9px 12px 6px 0; }
.name-area .unity-text-field { margin: 0; height: 29px; }
.name-area .unity-text-field__input { padding: 0 3px; background-color: transparent; color: rgb(240, 236, 224); border-width: 0; font-size: 18px; -unity-font-style: bold; }
.name-area .unity-text-field__input:focus { border-bottom-width: 1px; border-bottom-color: rgb(232, 182, 95); }
.identity-role { margin: 3px 0 0 3px; padding: 0; color: rgb(180, 183, 169); font-size: 10px; }
.deployment-actions { position: absolute; right: 24px; bottom: 22px; width: 244px; }
.secondary-button { height: 30px; margin: 0 0 7px 0; padding: 0 12px; border-width: 1px; border-color: rgba(178, 173, 155, .34); background-color: rgba(8, 11, 12, .60); color: rgb(208, 204, 190); font-size: 12px; -unity-text-align: middle-right; }
.secondary-button:hover { border-color: rgb(232, 182, 95); color: rgb(232, 182, 95); }
.primary-button { height: 62px; margin: 0; padding: 0 20px; border-width: 1px; border-color: rgb(245, 207, 136); background-color: rgb(232, 182, 95); color: rgb(33, 27, 16); font-size: 25px; -unity-font-style: bold; }
.primary-button:hover { background-color: rgb(246, 204, 131); }
.operator-caption { position: absolute; right: 24px; top: 84px; width: 138px; padding-top: 7px; border-top-width: 1px; border-top-color: rgba(232, 182, 95, .50); }
.operator-caption .body-text { margin-top: 4px; color: rgb(215, 207, 187); font-size: 13px; }
.preview-equipment { margin-top: 4px; padding: 0; font-size: 9px; color: rgb(168, 170, 154); }
.operations-view .operator-caption, .settings-view .operator-caption { display: none; }
.loadout-view .identity-card { display: none; }
.loadout-view .deployment-actions { width: 124px; right: 12px; }
.loadout-view .primary-button { height: 54px; font-size: 19px; padding: 0 8px; }
.loadout-view .secondary-button { font-size: 10px; padding: 0 8px; }
.panel-page { width: 388px; padding: 14px; background-color: rgba(7, 10, 12, .72); border-top-width: 1px; border-top-color: rgb(232, 182, 95); }
.page-title { margin: 0 0 12px 0; padding: 0; font-size: 24px; -unity-font-style: bold; }
.map-card { position: relative; height: 154px; border-width: 1px; border-color: rgba(232, 182, 95, .65); background-color: rgba(23, 26, 25, .38); }
.map-thumb { width: 100%; height: 112px; }
.map-name { position: absolute; left: 10px; top: 118px; margin: 0; padding: 0; font-size: 13px; }
.map-meta { position: absolute; right: 10px; top: 122px; margin: 0; padding: 0; font-size: 9px; color: rgb(160, 168, 148); }
.section-label { margin: 12px 0 6px 0; padding: 0; font-size: 11px; color: rgb(184, 185, 174); }
.mode-row { flex-direction: row; justify-content: space-between; }
.mode-card { width: 48.6%; height: 58px; padding: 8px; background-color: rgba(11, 16, 17, .56); border-width: 1px; border-color: rgba(184, 184, 169, .24); }
.mode-card.selected { border-color: rgb(232, 182, 95); background-color: rgba(91, 67, 30, .26); }
.mode-name { margin: 0; padding: 0; font-size: 13px; color: rgb(223, 223, 208); }
.mode-card .body-text { margin-top: 5px; font-size: 9px; }
.team-size-button { height: 33px; margin: 0; border-width: 1px; border-color: rgba(232, 182, 95, .38); background-color: rgba(37, 34, 24, .48); color: rgb(213, 208, 188); font-size: 10px; }
.loadout-page { width: 364px; bottom: 22px; }
.class-rail { position: absolute; left: 0; top: 0; width: 260px; }
.class-card { height: 34px; margin: 0 0 4px 0; padding: 0 12px; flex-direction: row; align-items: center; background-color: rgba(10, 14, 15, .67); border-width: 1px; border-color: rgba(179, 183, 171, .25); }
.class-card:hover { background-color: rgba(91, 67, 30, .40); }
.class-card.selected { border-color: rgb(232, 182, 95); border-left-width: 3px; background-color: rgba(132, 86, 31, .39); }
.class-symbol { width: 31px; padding: 0; margin: 0 7px 0 0; font-size: 23px; color: rgb(177, 185, 171); -unity-text-align: middle-center; }
.class-card.selected .class-symbol { color: rgb(232, 182, 95); }
.class-name { margin: 0; padding: 0; color: rgb(223, 222, 210); font-size: 15px; }
.loadout-workbench { position: absolute; left: 0; top: 178px; right: 0; bottom: 0; }
.weapon-slots, .utility-slots { flex-direction: row; justify-content: space-between; }
.loadout-slot { position: relative; margin: 0; padding: 0; background-color: rgba(9, 13, 15, .72); border-width: 1px; border-color: rgba(165, 175, 164, .29); }
.loadout-slot:hover { background-color: rgba(46, 42, 31, .72); }
.loadout-slot.selected { border-color: rgb(232, 182, 95); background-color: rgba(53, 43, 28, .70); }
.primary-slot { width: 60%; height: 96px; }
.secondary-slot { width: 38%; height: 96px; }
.slot-key { position: absolute; left: 8px; top: 6px; margin: 0; padding: 0; font-size: 10px; color: rgb(177, 179, 166); }
.slot-icon { position: absolute; left: 8px; right: 8px; top: 23px; height: 47px; }
.slot-name { position: absolute; left: 8px; right: 4px; bottom: 7px; margin: 0; padding: 0; color: rgb(227, 225, 211); font-size: 12px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.secondary-slot .slot-name { font-size: 11px; }
.utility-slots { margin-top: 6px; }
.utility-slot { width: 49%; height: 50px; }
.utility-icon { position: absolute; left: 8px; top: 8px; width: 37px; height: 32px; }
.utility-name { position: absolute; left: 54px; top: 8px; right: 2px; margin: 0; padding: 0; font-size: 11px; }
.utility-key { position: absolute; left: 54px; top: 27px; margin: 0; padding: 0; color: rgb(148, 155, 140); font-size: 9px; }
.selection-title { margin: 7px 0 4px 0; padding: 0; font-size: 10px; color: rgb(196, 188, 161); }
.weapon-options { height: 48px; flex-direction: row; justify-content: flex-start; }
.weapon-option { position: relative; width: 49%; height: 48px; margin: 0 6px 0 0; padding: 0; background-color: rgba(8, 12, 14, .69); border-width: 1px; border-color: rgba(154, 170, 160, .24); }
.weapon-option:hover { background-color: rgba(74, 57, 31, .58); }
.weapon-option.selected { border-color: rgb(232, 182, 95); background-color: rgba(104, 72, 31, .47); }
.weapon-option-icon { position: absolute; left: 7px; top: 3px; width: 108px; height: 25px; }
.weapon-option-name { position: absolute; left: 7px; right: 3px; bottom: 4px; margin: 0; padding: 0; font-size: 10px; color: rgb(203, 203, 186); }
.gadget-info { height: 54px; margin: 0; padding: 8px 10px; font-size: 11px; color: rgb(213, 207, 181); white-space: normal; background-color: rgba(13, 18, 17, .68); border-left-width: 2px; border-left-color: rgb(232, 182, 95); }
.equipment-card { margin-top: 7px; }
.stats-row { flex-direction: row; justify-content: space-between; }
.stat { width: 23.7%; height: 31px; background-color: rgba(12, 18, 18, .50); padding: 3px 6px; flex-direction: row; align-items: center; }
.stat-caption { padding: 0; margin: 0; color: rgb(155, 163, 148); font-size: 10px; }
.stat-value { padding: 0; margin: 0; flex-grow: 1; -unity-text-align: middle-right; color: rgb(232, 219, 185); font-size: 13px; }
.settings-page { width: 412px; }
.settings-page .page-title { margin-bottom: 9px; }
.settings-card { position: relative; height: 57px; flex-shrink: 0; margin: 0 0 6px 0; padding: 0; background-color: rgba(15, 21, 21, .51); }
.settings-card .mode-name { position: absolute; left: 12px; top: 6px; font-size: 12px; }
.settings-card .body-text { position: absolute; right: 12px; top: 6px; width: 58px; -unity-text-align: middle-right; font-size: 11px; color: rgb(217, 205, 172); }
.settings-card .unity-slider { position: absolute; left: 10px; right: 12px; top: 29px; height: 16px; margin: 0; }
.settings-card .unity-base-slider__tracker { background-color: rgb(95, 102, 91); }
.settings-card .unity-base-slider__dragger { background-color: rgb(232, 182, 95); border-color: rgb(232, 182, 95); }
.settings-page .crosshair-card { height: 68px; }
.crosshair-card .unity-slider { right: 90px; top: 37px; }
.crosshair-card .body-text { right: 87px; }
.crosshair-preview { position: absolute; right: 8px; top: 3px; width: 62px; height: 62px; background-color: rgba(8, 14, 14, .68); }
.settings-page .controls-card { height: 62px; margin-bottom: 0; }
.control-text { position: absolute; left: 12px; right: 10px; top: 25px; margin: 0; padding: 0; font-size: 9px; color: rgb(178, 184, 164); white-space: normal; }
.compact .page { top: 76px; bottom: 105px; }
.compact .loadout-page { bottom: 18px; }
.compact .class-card { height: 31px; margin-bottom: 3px; }
.compact .loadout-workbench { top: 164px; }
.compact .settings-card { height: 50px; }
.compact .settings-page .crosshair-card { height: 62px; }
.compact .settings-page .controls-card { height: 53px; }
.compact .settings-card .unity-slider { top: 25px; }
.compact .crosshair-card .unity-slider { top: 33px; }
.compact .settings-page .page-title { font-size: 22px; margin-bottom: 7px; }
.compact .control-text { top: 23px; }
